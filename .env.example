# Copy to .env and supply credentials locally or through the host dashboard.
NODE_ENV=development
PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=1d
SECURITY_ENCRYPTION_KEY=

# Local PostgreSQL fallback (used when SUPABASE_DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fitnexis
DATABASE_URL=
PROD_DATABASE_URL=

# Supabase server configuration. Keep secret keys out of browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_DATABASE_URL=
# Append ?sslrootcert=prod-ca-2021.crt to the Supabase PostgreSQL URL.
SUPABASE_STORAGE_BUCKET=fitnexis-profile-photos

# Resend HTTPS email delivery; verify this sender's domain in Resend.
RESEND_API_KEY=
RESEND_FROM="Fitnexis <no-reply@fitnexis.app>"

# Optional platform administrator creation and payments.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=
PAYSTACK_SECRET_KEY=
ALLOW_PLATFORM_COLLECTION=false
ENABLE_BILLING_JOBS=false
